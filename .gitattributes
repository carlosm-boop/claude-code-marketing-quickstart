# Normalize line endings.
#
# Without this, a Windows checkout rewrites every file to CRLF and `git status`
# shows the entire repo as modified (4,489 insertions / 4,489 deletions of
# identical content), which buries real changes.
#
# This file fixes future checkouts. To normalize what is already in the working
# tree, run once and commit the result:
#
#     git add --renormalize .
#     git commit -m "chore: normalize line endings to LF"
#
* text=auto eol=lf

# Binary — never touch
*.png binary
*.jpg binary
*.pdf binary
*.pptx binary
*.xlsx binary
*.docx binary
